{
  "name": "lyrics-extractor",
  "version": "1.6.1",
  "description": "MuseScore 4 extension that extracts lyrics with aligned chords from a score",
  "license": "GPL-3.0-or-later",
  "author": "Manolo Carrasco (do2tis)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manolo/lyrics-extractor.git"
  },
  "main": "cli/index.js",
  "bin": {
    "lyrics-extractor": "cli/index.js"
  },
  "scripts": {
    "test": "node --test 'test/**/*.test.js'",
    "build": "node build.js",
    "test:package": "node build.js dev --keep-build && LE_CLI=.build/cli/index.js node --test 'test/**/*.test.js'",
    "install-local": "node build.js dev --install"
  },
  "devDependencies": {
    "terser": "5.44.0"
  },
  "engines": {
    "node": ">=20"
  },
  "private": false
}
